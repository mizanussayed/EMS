{
  "info": {
    "name": "EMS API",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/auth/register",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"teacher\",\n  \"password\": \"Password123\",\n  \"role\": \"Teacher\"\n}"
            }
          }
        },
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/auth/login",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"userName\": \"admin\",\n  \"password\": \"Password123\"\n}"
            }
          }
        },
        {
          "name": "Refresh",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" }
            ],
            "url": "{{baseUrl}}/api/auth/refresh",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "List students",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/students"
          }
        },
        {
          "name": "Create student",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/students",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"firstName\": \"Noor\",\n  \"lastName\": \"Rahman\",\n  \"admissionNumber\": \"S1003\",\n  \"className\": \"Grade 1\",\n  \"section\": \"A\",\n  \"gender\": \"Female\",\n  \"active\": true\n}"
            }
          }
        },
        {
          "name": "Update student",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/students/{{studentId}}",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"id\": {{studentId}},\n  \"firstName\": \"Noor\",\n  \"lastName\": \"Rahman\",\n  \"admissionNumber\": \"S1003\",\n  \"className\": \"Grade 1\",\n  \"section\": \"A\",\n  \"gender\": \"Female\",\n  \"active\": true\n}"
            }
          }
        },
        {
          "name": "Delete student",
          "request": {
            "method": "DELETE",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/students/{{studentId}}"
          }
        }
      ]
    },
    {
      "name": "Attendance",
      "item": [
        {
          "name": "Get attendance by class",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/attendance/{{className}}"
          }
        },
        {
          "name": "Create attendance",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/attendance",
            "body": {
              "mode": "raw",
              "raw": "{\n  \"studentId\": {{studentId}},\n  \"date\": \"2026-04-25\",\n  \"status\": \"Present\",\n  \"notes\": \"On time\"\n}"
            }
          }
        }
      ]
    },
    {
      "name": "Dashboard",
      "item": [
        {
          "name": "Get summary",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/dashboard"
          }
        }
      ]
    },
    {
      "name": "Audit",
      "item": [
        {
          "name": "Get audit logs",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "url": "{{baseUrl}}/api/audit"
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "studentId", "value": "1" },
    { "key": "className", "value": "Grade 1" }
  ]
}
